rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'username',
          'email',
          'provider',
          'storageTier',
          'storageLimitBytes',
          'storageUsedBytes',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'username',
          'email',
          'provider',
          'photoUrl',
          'storageTier',
          'storageLimitBytes',
          'storageUsedBytes',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.username is string
        && data.username.size() >= 2 && data.username.size() <= 64
        && data.email is string
        && data.email.size() >= 3 && data.email.size() <= 160
        && data.provider is string
        && data.provider in ['google', 'password']
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 512))
        && data.storageTier is string
        && data.storageTier == 'free_10gb'
        && data.storageLimitBytes is number
        && data.storageLimitBytes == 10737418240
        && data.storageUsedBytes is number
        && data.storageUsedBytes >= 0
        && data.storageUsedBytes <= 10737418240
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserFile(data, userId, fileId) {
      return data.keys().hasAll(['id', 'userId', 'originalName', 'sizeBytes', 'mimeType', 'shareUrl', 'deleteToken', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'originalName', 'sizeBytes', 'mimeType', 'shareUrl', 'deleteToken', 'createdAt', 'hasPassword', 'expiresAt'])
        && data.id is string
        && data.id == fileId
        && data.id.size() >= 1 && data.id.size() <= 64
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.originalName is string
        && data.originalName.size() >= 1 && data.originalName.size() <= 255
        && data.sizeBytes is number
        && data.sizeBytes >= 0
        && data.sizeBytes <= 524288000
        && data.mimeType is string
        && data.mimeType.size() >= 1 && data.mimeType.size() <= 128
        && data.shareUrl is string
        && data.shareUrl.size() >= 1 && data.shareUrl.size() <= 256
        && data.deleteToken is string
        && data.deleteToken.size() >= 1 && data.deleteToken.size() <= 128
        && (!('hasPassword' in data) || data.hasPassword is bool)
        && (!('expiresAt' in data) || (data.expiresAt is string && data.expiresAt.size() <= 64))
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'username',
          'email',
          'provider',
          'photoUrl',
          'storageTier',
          'storageLimitBytes',
          'storageUsedBytes',
          'updatedAt'
        ]);
      allow delete: if false;

      match /files/{fileId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(fileId) && existing().userId == request.auth.uid;
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(fileId)
          && isValidUserFile(incoming(), userId, fileId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && getAfter(/databases/$(database)/documents/users/$(userId)).data.storageLimitBytes == 10737418240
          && getAfter(/databases/$(database)/documents/users/$(userId)).data.storageUsedBytes <= 10737418240;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(fileId)
          && existing().userId == request.auth.uid
          && isValidUserFile(incoming(), userId, fileId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().sizeBytes == existing().sizeBytes
          && incoming().shareUrl == existing().shareUrl
          && incoming().deleteToken == existing().deleteToken
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['originalName', 'mimeType', 'hasPassword', 'expiresAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(fileId) && existing().userId == request.auth.uid;
      }
    }
  }
}
