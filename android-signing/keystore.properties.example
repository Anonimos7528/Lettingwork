# Copia este archivo como "keystore.properties" dentro de esta misma carpeta (android-signing/)
# o configúralo como Secrets en GitHub Actions para firmar tu APK automáticamente.
#
# Si aún no tienes una firma (.jks), puedes crear una con este comando:
# keytool -genkey -v -keystore android-signing/release-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias lettingwork

storeFile=release-keystore.jks
storePassword=TU_CONTRASEÑA_DEL_KEYSTORE
keyAlias=lettingwork
keyPassword=TU_CONTRASEÑA_DE_LA_CLAVE
